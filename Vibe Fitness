      font-size: clamp(60px, 10vw, 150px);
      line-height: 0.85;
      text-transform: uppercase;
    }

    .statement h2 span {
      color: var(--lime);
    }

    /* =========================
       STATS
    ========================= */

    .stats {
      max-width: 1300px;
      margin: auto;

      display: grid;
      grid-template-columns: repeat(4, 1fr);

      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .stat {
      padding: 50px 25px;
      border-right: 1px solid var(--border);
      text-align: center;
    }

    .stat:last-child {
      border-right: 0;
    }

    .stat strong {
      display: block;

      font-family: "Oswald", sans-serif;
      font-size: 55px;
      color: var(--lime);
    }

    .stat span {
      display: block;
      margin-top: 8px;

      color: #aaa;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* =========================
       LOCATION
    ========================= */

    .location {
      max-width: 1300px;
      margin: auto;

      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }

