  <style>

    :root {
      --black: #080808;
      --dark: #101010;
      --dark-2: #171717;
      --white: #f5f5f5;
      --muted: #a1a1a1;
      --lime: #d8ff3e;
      --border: rgba(255,255,255,0.10);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--black);
      color: var(--white);
      font-family: "Inter", sans-serif;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      width: 100%;
      display: block;
    }

    /* =========================
       NAVIGATION
    ========================= */

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;

      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 24px 5%;

      transition: 0.4s ease;
    }

    .nav.scrolled {
      background: rgba(8,8,8,0.92);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
      padding-top: 15px;
      padding-bottom: 15px;
    }

    .logo {
      font-family: "Oswald", sans-serif;
      font-size: 25px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .logo span {
      color: var(--lime);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 30px;
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .nav-links a {
      opacity: 0.8;
      transition: 0.3s;
    }

    .nav-links a:hover {
      opacity: 1;
      color: var(--lime);
    }

    .nav-cta {
      background: var(--lime);
      color: #000;
      padding: 13px 22px;
      font-weight: 800;
      border-radius: 2px;
    }

    .menu {
      display: none;
      font-size: 25px;
      cursor: pointer;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 100vh;
      position: relative;

      display: flex;
      align-items: center;

      overflow: hidden;

      background:
        linear-gradient(
          90deg,
          rgba(0,0,0,0.92) 0%,
          rgba(0,0,0,0.70) 45%,
          rgba(0,0,0,0.35) 100%
        ),
        url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=2200&q=90")
        center/cover;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          transparent 60%,
          var(--black) 100%
        );

      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      width: min(1100px, 90%);
      margin: auto;
    }

    .eyebrow {
      color: var(--lime);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-family: "Oswald", sans-serif;
      font-size: clamp(70px, 11vw, 170px);
      line-height: 0.82;
      text-transform: uppercase;
      letter-spacing: -4px;
      max-width: 1000px;
    }

    .hero h1 span {
      color: var(--lime);
    }

    .hero-sub {
      margin-top: 35px;
      max-width: 500px;
      color: #d0d0d0;
      line-height: 1.7;
      font-size: 16px;
    }

    .hero-actions {
      display: flex;
      gap: 14px;
      margin-top: 35px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 17px 28px;
      border: 1px solid var(--lime);
      text-transform: uppercase;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.5px;
      transition: 0.3s;
    }

    .btn-primary {
      background: var(--lime);
      color: #000;
    }

    .btn:hover {
      transform: translateY(-4px);
    }

    .hero-location {
      position: absolute;
      bottom: 35px;
      right: 5%;
      z-index: 5;

      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #aaa;
    }

    /* =========================
       INTRO
    ========================= */

    section {
      padding: 120px 5%;
    }

    .intro {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      max-width: 1300px;
      margin: auto;
    }

    .section-number {
      color: var(--lime);
      font-family: "Oswald", sans-serif;
      font-size: 14px;
      letter-spacing: 3px;
      margin-bottom: 20px;
    }

    .big-heading {
      font-family: "Oswald", sans-serif;
      font-size: clamp(50px, 7vw, 100px);
      line-height: 0.9;
      text-transform: uppercase;
    }

    .big-heading span {
      color: var(--lime);
    }

    .intro-copy {
      color: var(--muted);
      line-height: 1.9;
      font-size: 16px;
    }

    /* =========================
       EXPERIENCE
    ========================= */

    .dark-section {
      background: var(--dark);
    }

    .section-heading {
      max-width: 1300px;
      margin: auto;
      margin-bottom: 60px;
    }

    .cards {
      max-width: 1300px;
      margin: auto;

      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .card {
      min-height: 430px;
      position: relative;
      overflow: hidden;

      background: #222;

      display: flex;
      flex-direction: column;
      justify-content: flex-end;

      padding: 35px;

      transition: 0.5s;
    }

    .card:hover {
      transform: translateY(-10px);
    }

    .card::before {
      content: "";
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          transparent 20%,
          rgba(0,0,0,0.9)
        );

      z-index: 1;
    }

    .card:nth-child(1) {
      background:
        url("https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?auto=format&fit=crop&w=1000&q=85")
        center/cover;
    }

    .card:nth-child(2) {
      background:
        url("https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=1000&q=85")
        center/cover;
    }

    .card:nth-child(3) {
      background:
        url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1000&q=85")
        center/cover;
    }

    .card-content {
      position: relative;
      z-index: 2;
    }

    .card-number {
      color: var(--lime);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2px;
      margin-bottom: 12px;
    }

    .card h3 {
