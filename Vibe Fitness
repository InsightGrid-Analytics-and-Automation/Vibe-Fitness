      margin-top: 10px;
      line-height: 1.6;
      font-size: 14px;
    }

    /* =========================
       STATEMENT
    ========================= */

    .statement {
      min-height: 70vh;

      display: flex;
      align-items: center;

      background:
        linear-gradient(
