      border: 1px solid var(--border);
      padding: 45px;
    }

    .location-box h3 {
      font-family: "Oswald", sans-serif;
      font-size: 42px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .location-box p {
      color: #aaa;
      line-height: 1.8;
    }

    .location-list {
      margin-top: 30px;
      list-style: none;
    }

    .location-list li {
      padding: 15px 0;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      color: #bbb;
    }

    .location-list strong {
      color: white;
    }

    /* =========================
       CTA
    ========================= */

    .cta {
      background: var(--lime);
      color: #000;
      text-align: center;
    }

    .cta h2 {
      font-family: "Oswald", sans-serif;
      font-size: clamp(60px, 10vw, 140px);
      line-height: 0.85;
      text-transform: uppercase;
    }

    .cta p {
      max-width: 500px;
      margin: 30px auto;
      line-height: 1.7;
    }

    .cta-button {
      display: inline-block;
      background: #000;
      color: white;
      padding: 18px 35px;

      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;

      transition: 0.3s;
    }

    .cta-button:hover {
      transform: scale(1.05);
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 50px 5%;
      background: #050505;

      display: flex;
      justify-content: space-between;
      align-items: center;

      color: #777;
      font-size: 12px;
    }

    footer strong {
      color: white;
      font-family: "Oswald", sans-serif;
      letter-spacing: 2px;
      font-size: 18px;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 900px) {

      .nav-links {
        display: none;
      }

      .menu {
        display: block;
      }

      .intro,
      .location {
        grid-template-columns: 1fr;
        gap: 45px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .stat:nth-child(2) {
        border-right: 0;
      }

      .stat:nth-child(-n+2) {
        border-bottom: 1px solid var(--border);
      }

      .hero h1 {
        letter-spacing: -2px;
      }
    }

    @media (max-width: 600px) {

      section {
        padding: 80px 6%;
      }

      .nav {
        padding: 18px 6%;
      }

      .nav-cta {
        display: none;
      }

      .hero {
        min-height: 90vh;
      }

      .hero-content {
        width: 88%;
      }

      .hero h1 {
        font-size: 72px;
      }

      .hero-sub {
        font-size: 14px;
      }

      .hero-location {
        display: none;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .stat {
        border-right: 0;
        border-bottom: 1px solid var(--border);
      }

      .stat:last-child {
        border-bottom: 0;
      }

      .location-box {
        padding: 30px;
      }

      footer {
        flex-direction: column;
        gap: 20px;
        text-align: center;
      }
    }

  </style>

</head>

